# Postgres, non-pooling URL. Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# openssl rand -base64 32  — required, min 32 chars
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"
# Separate key used to encrypt SMTP passwords stored from the admin UI.
SETTINGS_SECRET="replace-with-another-long-random-string-32"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed / create-admin. Change immediately. First login forces a new password.
ADMIN_EMAIL="admin@example.com"
ADMIN_TEMP_PASSWORD="ChangeMe!2026"

# Optional. Admin UI can override these. Prefer env in production.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Daulat Drive <mail@gmail.com>"

# Optional media backends. If unset, uploads stay in public/uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_URL=""

# Optional defaults. Admin settings override these when saved.
GA_MEASUREMENT_ID=""
GSC_VERIFICATION_TOKEN=""
